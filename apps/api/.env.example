# Railway supplies DATABASE_URL from its PostgreSQL service.
DATABASE_URL=postgresql://postgres:password@localhost:5432/bellgrinda
PORT=3001
# Use the deployed PWA URL in production, for example https://app.bellgrinda.com
CORS_ORIGIN=http://localhost:5173
# The web app reads local VITE_ variables from this shared environment directory.
VITE_API_BASE_URL=http://localhost:3001
# Temporary local identity until account authentication is introduced.
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001
# Generate a free prototype key at https://build.nvidia.com/models
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
